{
  "schemaVersion": 1,
  "id": "ffcafe.overlay-skyline",
  "name": "Skyline",
  "description": "横向布局的精简伤害统计悬浮窗，支持展开详细数据、查看战斗历史与自定义配色。",
  "version": "0.2.1",
  "apiVersion": "^2.0.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": [
    "ui.register",
    "ui.overlayplugin",
    "services.consume",
    "session.read",
    "game.read",
    "events.read",
    "data.read",
    "identity.read"
  ],
  "networkOrigins": [],
  "services": {
    "consumes": [
      {
        "name": "ffcafe.combat-statistics/overlay",
        "versionRange": "^1.0.0",
        "optional": false
      }
    ]
  },
  "license": "Apache-2.0"
}
