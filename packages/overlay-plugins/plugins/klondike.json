{
  "schemaVersion": 1,
  "id": "ffcafe.overlay-klondike",
  "name": "Klondike",
  "description": "现代风格的伤害统计悬浮窗，提供伤害占比条，支持点击成员查看详细数据，并可在非战斗时收起。",
  "version": "0.1.1",
  "apiVersion": "^2.0.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": [
    "ui.register",
    "ui.overlayplugin",
    "services.consume",
    "session.read",
    "game.read",
    "events.read",
    "data.read",
    "identity.read"
  ],
  "networkOrigins": [],
  "services": {
    "consumes": [
      {
        "name": "ffcafe.combat-statistics/overlay",
        "versionRange": "^1.0.0",
        "optional": false
      }
    ]
  }
}
