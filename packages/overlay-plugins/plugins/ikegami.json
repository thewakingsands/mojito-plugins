{
  "schemaVersion": 1,
  "id": "ffcafe.overlay-ikegami",
  "name": "ikegami",
  "description": "横向布局的精简伤害统计悬浮窗，鼠标悬停时显示详细数据。",
  "version": "0.1.3",
  "apiVersion": "^2.0.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": [
    "ui.register",
    "ui.overlayplugin",
    "services.consume",
    "session.read",
    "game.read",
    "events.read",
    "data.read",
    "identity.read"
  ],
  "networkOrigins": [],
  "services": {
    "consumes": [
      {
        "name": "ffcafe.combat-statistics/overlay",
        "versionRange": "^1.0.0",
        "optional": false
      }
    ]
  },
  "license": "GPL-3.0-or-later"
}
