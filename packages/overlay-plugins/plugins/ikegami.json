{
  "schemaVersion": 1,
  "id": "OverlayIkegami",
  "name": "ikegami",
  "description": "需要先安装并启用战斗统计。",
  "version": "0.1.0",
  "apiVersion": "^2.0.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": [
    "ui.register",
    "ui.overlayplugin",
    "services.consume",
    "session.read",
    "game.read",
    "events.read",
    "data.read",
    "identity.read"
  ],
  "networkOrigins": [],
  "services": {
    "consumes": [
      {
        "name": "CombatStatistics/overlay",
        "versionRange": "^1.0.0",
        "optional": false
      }
    ]
  }
}
