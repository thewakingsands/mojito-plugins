{
  "schemaVersion": 1,
  "id": "ffcafe.overlay-cmskin",
  "name": "CMSkin",
  "description": "由 CanisMinor 制作的中文伤害统计悬浮窗，支持查看成员详细数据，并提供迷你与透明模式。",
  "version": "0.1.1",
  "apiVersion": "^2.0.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": [
    "ui.register",
    "ui.overlayplugin",
    "services.consume",
    "session.read",
    "game.read",
    "events.read",
    "data.read",
    "identity.read"
  ],
  "networkOrigins": [],
  "services": {
    "consumes": [
      {
        "name": "ffcafe.combat-statistics/overlay",
        "versionRange": "^1.0.0",
        "optional": false
      }
    ]
  },
  "license": "MIT"
}
