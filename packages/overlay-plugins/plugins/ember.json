{
  "schemaVersion": 1,
  "id": "ffcafe.overlay-ember",
  "name": "Ember",
  "description": "数据详尽的伤害统计悬浮窗，按标签页分别显示伤害、治疗、承伤与团队数据。",
  "version": "0.1.2",
  "apiVersion": "^2.1.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": [
    "ui.register",
    "ui.overlayplugin",
    "services.consume",
    "session.read",
    "game.read",
    "events.read",
    "data.read",
    "identity.read"
  ],
  "networkOrigins": [],
  "services": {
    "consumes": [
      {
        "name": "ffcafe.combat-statistics/overlay",
        "versionRange": "^1.0.0",
        "optional": false
      }
    ]
  },
  "license": "GPL-3.0-only"
}
