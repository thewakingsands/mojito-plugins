{
  "schemaVersion": 1,
  "id": "ffcafe.overlay-glass",
  "name": "Glass",
  "description": "半透明玻璃质感的伤害统计悬浮窗，提供默认、深色与浅色三种主题，可切换伤害、治疗与承伤视图。",
  "version": "0.1.3",
  "apiVersion": "^2.0.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": [
    "ui.register",
    "ui.overlayplugin",
    "services.consume",
    "session.read",
    "game.read",
    "events.read",
    "data.read",
    "identity.read"
  ],
  "networkOrigins": [],
  "services": {
    "consumes": [
      {
        "name": "ffcafe.combat-statistics/overlay",
        "versionRange": "^1.0.0",
        "optional": false
      }
    ]
  }
}
