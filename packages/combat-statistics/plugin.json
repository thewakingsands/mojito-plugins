{
  "schemaVersion": 1,
  "id": "CombatStatistics",
  "name": "战斗统计",
  "version": "0.2.0",
  "apiVersion": "^1.0.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": {
    "required": ["session.read", "game.read", "events.read", "data.read", "ui.register", "services.provide"],
    "optional": []
  },
  "networkOrigins": [],
  "storage": { "totalBytes": 2147483648, "fileBytes": 16777216 },
  "services": {
    "provides": [
      {
        "name": "combat.statistics.overlay",
        "version": "1.0.0",
        "dataPermissions": ["session.read", "game.read", "events.read", "data.read"]
      }
    ]
  }
}
