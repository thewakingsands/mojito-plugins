{
  "schemaVersion": 1,
  "id": "ffcafe.combat-statistics",
  "name": "战斗统计",
  "description": "统计小队成员的伤害、治疗与承伤，记录每场战斗并支持回顾分析，同时为悬浮窗插件提供战斗数据。",
  "author": "FFCafe",
  "version": "0.4.1",
  "apiVersion": "^2.0.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": [
    "session.read",
    "game.read",
    "events.read",
    "data.read",
    "ui.register",
    "services.provide",
    "identity.read",
    "http.request"
  ],
  "networkOrigins": ["https://mojo.ffcafe.cn"],
  "storage": {
    "totalBytes": 2147483648,
    "fileBytes": 16777216
  },
  "services": {
    "provides": [
      {
        "name": "overlay",
        "version": "1.0.0"
      }
    ]
  }
}
