{
  "schemaVersion": 1,
  "id": "CombatStatistics",
  "name": "Synthetic overlay fixture",
  "version": "1.0.0",
  "apiVersion": "^1.1.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": {
    "required": [
      "ui.register",
      "ui.overlayplugin",
      "services.provide",
      "session.read",
      "game.read",
      "events.read",
      "data.read"
    ],
    "optional": ["ui.overlayplugin.remote"]
  },
  "networkOrigins": [],
  "services": {
    "provides": [
      {
        "name": "combat.statistics.overlay",
        "version": "1.0.0",
        "dataPermissions": ["session.read", "game.read", "events.read", "data.read"]
      }
    ]
  }
}
