{
  "schemaVersion": 1,
  "id": "CombatStatistics",
  "name": "Synthetic overlay fixture",
  "version": "1.0.0",
  "apiVersion": "^2.0.0",
  "entry": {
    "kind": "worker",
    "path": "entry.mjs"
  },
  "capabilities": [
    "ui.register",
    "ui.overlayplugin",
    "services.provide",
    "session.read",
    "game.read",
    "events.read",
    "data.read",
    "ui.overlayplugin.remote"
  ],
  "networkOrigins": [],
  "services": {
    "provides": [
      {
        "name": "overlay",
        "version": "1.0.0"
      }
    ]
  }
}
