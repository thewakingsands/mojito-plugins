diff --git a/src/components/Parser/SpellGrid/GameIcon.js b/src/components/Parser/SpellGrid/GameIcon.js
new file mode 100644
index 00000000..ff586215
--- /dev/null
+++ b/src/components/Parser/SpellGrid/GameIcon.js
@@ -0,0 +1,24 @@
+import React, { useEffect, useState } from "react";
+
+export default function GameIcon({ type, id }) {
+    const [image, setImage] = useState(null);
+    useEffect(() => {
+        let active = true;
+        let retry;
+        setImage(null);
+        function load() {
+            window.OverlayPluginApi.callHandler(
+                JSON.stringify({ call: "getGameIcon", type, id: Number(id) }),
+                raw => {
+                    if (!active) return;
+                    const result = JSON.parse(raw);
+                    if (typeof result === "string") setImage(result);
+                    else if (result && result.error === "unavailable") retry = setTimeout(load, 1000);
+                }
+            );
+        }
+        load();
+        return () => { active = false; clearTimeout(retry); };
+    }, [type, id]);
+    return <img src={image || undefined} alt={type + "-" + id} style={{ visibility: image ? "visible" : "hidden" }}/>;
+}
