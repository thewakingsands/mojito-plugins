diff --git a/src/components/Parser/AggroTable/Monster.test.js b/src/components/Parser/AggroTable/Monster.test.js
new file mode 100644
index 0000000..eca656a
--- /dev/null
+++ b/src/components/Parser/AggroTable/Monster.test.js
@@ -0,0 +1,50 @@
+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import Monster from "./Monster";
+
+jest.mock("../../../processors/PlayerProcessor", () => ({
+	getDataValue: (key, player) => player[key],
+}));
+jest.mock("../../../processors/MonsterProcessor", () => ({}));
+jest.mock("../PercentBar", () => () => null);
+jest.mock("../JobIcon", () => ({ job }) => job);
+
+const combatants = {
+	"YOU": { Job: "WAR" },
+	"Synthetic Ally@21 [10a0]": { Job: "WHM" },
+	"Synthetic Ally@22 [10b0]": { Job: "PLD" },
+	"Legacy Ally": { Job: "SCH" },
+};
+
+function renderTarget(target) {
+	return renderToStaticMarkup(
+		<Monster
+			monster={{ Target: target, _is_current: target?.isMe }}
+			encounter={{ Combatant: combatants }}
+			columns={["player_Name"]}
+			short_names="no_short"
+		/>
+	);
+}
+
+test("selects the combatant by target ID when two characters share a name", () => {
+	const html = renderTarget({ ID: 0x10b0, Name: "Synthetic Ally" });
+	expect(html).toContain("PLD");
+	expect(html).not.toContain("WHM");
+	expect(html).toContain("Synthetic Ally");
+});
+
+test("matches the target by ID when display names differ or are missing", () => {
+	expect(renderTarget({ ID: 0x10a0, Name: "Ally 1" })).toContain("WHM");
+	expect(renderTarget({ ID: 0x10a0 })).toContain("WHM");
+});
+
+test("renders the self and legacy name-keyed jobs", () => {
+	expect(renderTarget({ ID: 1, Name: "Synthetic Self", isMe: true })).toContain("WAR");
+	expect(renderTarget({ ID: 2, Name: "Legacy Ally" })).toContain("SCH");
+});
+
+test("leaves an empty icon for an unknown or absent target", () => {
+	expect(renderTarget({ ID: 3, Name: "Synthetic Ally" })).toContain('class="column icon"></div>');
+	expect(renderTarget(null)).toContain('class="column icon"></div>');
+});
diff --git a/src/components/Parser/JobIcon.js b/src/components/Parser/JobIcon.js
new file mode 100644
index 0000000..a63fb1b
--- /dev/null
+++ b/src/components/Parser/JobIcon.js
@@ -0,0 +1,18 @@
+import React, { useEffect, useState } from "react";
+import { jobId, loadJobIcon } from "../../mojito-job-icons";
+
+export default function JobIcon({ job, ...props }) {
+    const id = jobId(job);
+    const [loaded, setLoaded] = useState(null);
+    useEffect(() => {
+        let active = true;
+        loadJobIcon(id).then(url => {
+            if (active && url) setLoaded({ id, url });
+        });
+        return () => { active = false; };
+    }, [id]);
+
+    return loaded && loaded.id === id
+        ? <img {...props} src={loaded.url} alt={job} onError={() => setLoaded(null)} />
+        : <span {...props}>{job}</span>;
+}
