{
  "compilerOptions": {
    "target": "es2023",
    "module": "node20",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "node16",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "removeComments": false,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "lib": ["es2023", "dom"],
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"]
}
